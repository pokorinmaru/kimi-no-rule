{
  "name": "@kimi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle:stored": "node scripts/bundle-stored.ts",
    "deploy": "node scripts/bundle-stored.ts && wrangler deploy",
    "build:cf": "node scripts/bundle-stored.ts && wrangler deploy --dry-run --outdir dist-cf"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@kimi/core": "workspace:*",
    "@kimi/interpret": "workspace:*",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
